# Apify token for the LinkedIn jobs scraper (job search and cron).
APIFY_TOKEN=

# Upstash Redis REST credentials (alerts, search cache, usage limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend API key and the verified sender address for alert emails.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Shared secret required by GET /api/cron/check-alerts.
CRON_SECRET=

# Public base URL used in alert email links. Falls back to VERCEL_URL, then the request origin.
NEXT_PUBLIC_APP_URL=

# CV analysis provider: gemini, anthropic or sample. Defaults to whichever key is set, else sample.
LLM_PROVIDER=
# Gemini API key for CV analysis.
GEMINI_API_KEY=
# Gemini model override; defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=
# Anthropic API key for CV analysis.
ANTHROPIC_API_KEY=

# Daily live-search cap per IP (default 10).
# DEMO_SEARCH_PER_IP=10
# Daily live-search cap across all visitors (default 40).
# DEMO_SEARCH_GLOBAL=40
# Daily live CV analyses per IP (default 10).
# DEMO_CV_PER_IP=10
# Daily live CV analyses across all visitors (default 40).
# DEMO_CV_GLOBAL=40
# Alerts allowed per email address (default 3).
# DEMO_ALERTS_PER_EMAIL=3
# Alerts allowed in total (default 25).
# DEMO_ALERTS_GLOBAL=25
# Monthly Apify spend at which live searches and the cron stop (default 4).
# APIFY_MONTHLY_BUDGET_USD=4
# Estimated Apify cost per returned result (default 0.002).
# APIFY_COST_PER_RESULT_USD=0.002
